{
  "name": "pg-fluent",
  "version": "0.0.1",
  "description": "Supabase-style fluent query API (postgrest-js) executed directly against PostgreSQL over the wire protocol.",
  "license": "MIT",
  "author": "Mathew Gerald <mathewgerald.14@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerald-mathew/pg-fluent.git"
  },
  "homepage": "https://github.com/gerald-mathew/pg-fluent#readme",
  "bugs": {
    "url": "https://github.com/gerald-mathew/pg-fluent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pg-fluent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/build-cjs-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/bench.mjs",
    "publint": "publint",
    "attw": "attw --pack .",
    "check:dist": "node scripts/check-dist.mjs",
    "check:package": "node scripts/check-dist.mjs && publint && attw --pack .",
    "prepublishOnly": "npm run build && npm run check:package"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.117.3",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "pg-copy-streams": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "pg-copy-streams": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "pg-copy-streams": "^7.0.0",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "supabase",
    "postgrest",
    "query-builder",
    "sql",
    "pg"
  ]
}
